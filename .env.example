# Copie para .env.local e preencha com as credenciais MySQL do seu provedor.
# Em desenvolvimento, sem as variáveis MYSQL_* obrigatórias, o site usa o
# armazenamento local em data/local-db.json. Em produção, configure MySQL:
# o modo local é recusado para evitar sessões que somem entre instâncias.

MYSQL_HOST="sql311.infinityfree.com"
MYSQL_PORT=3306
MYSQL_DATABASE="SEU_BANCO"
MYSQL_USER="SEU_USUARIO"
MYSQL_PASSWORD="SUA_SENHA"
MYSQL_CONNECTION_LIMIT=2

STAFF_USERNAME="kdss"
STAFF_PASSWORD="troque-esta-senha"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcionais
# MYSQL_CONNECT_TIMEOUT_MS=8000
# MYSQL_COOLDOWN_MS=15000
