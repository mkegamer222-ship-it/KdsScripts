# Copie para .env.local e preencha.
#
# SEM MONGODB_URI (e sem HOSTS/HOST): o site roda em MODO LOCAL,
# guardando os dados em data/local-db.json — ótimo para desenvolver.

MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="kdss"
STAFF_USERNAME="kdss"
STAFF_PASSWORD="troque-esta-senha"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Opcionais (avançado)
